---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro';
---
<BaseLayout title="画像トリミング｜5秒で使えるツール.com" description="画像の必要な部分をドラッグで切り抜いて保存できます。"><Header /><main class="container crop-page"><p class="eyebrow">画像</p><h1>画像トリミング</h1><p class="lead">画像を選び、残したい範囲をドラッグして切り抜きます。</p><label class="crop-upload"><input id="crop-file" type="file" accept="image/*,.svg" />画像を選択</label><div class="canvas-wrap" id="canvas-wrap" hidden><canvas id="crop-canvas"></canvas></div><div class="crop-actions"><button id="whole" type="button" disabled>全体を選択</button><button id="crop" type="button" disabled>切り抜く</button><button id="clear" type="button">クリア</button></div><p id="crop-status" class="status" role="status">画像を選択してください</p><div id="crop-result"></div><p class="notice">画像はサーバーへ送信せず、このブラウザ内で処理します。切り抜き後の画像はページを閉じると消えます。</p><p class="tool-id">T12</p></main><Footer /></BaseLayout>
<style>
  .crop-page h1{margin-bottom:10px}.lead{color:#555;margin:0 0 24px}.crop-upload{display:inline-block;border:1px solid #ccc;border-radius:7px;padding:10px 14px;background:#fff;cursor:pointer;font-weight:600}.crop-upload input{position:absolute;width:1px;height:1px;opacity:0}.canvas-wrap{margin-top:20px;max-width:680px;overflow:hidden;cursor:crosshair;background:#f4f4f4}.canvas-wrap canvas{display:block;max-width:100%;height:auto}.crop-actions{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0 4px}.crop-actions button{border-radius:7px}.crop-actions button:nth-child(2){background:var(--accent);color:#fff;border-color:var(--accent)}.status{min-height:1.6em;color:#555}.crop-result{margin-top:18px}.crop-result img{display:block;max-width:100%;max-height:420px;object-fit:contain;margin-bottom:10px}.crop-result a{color:var(--accent);font-weight:600}.notice{color:#666;font-size:.82rem;margin-top:24px}.tool-id{color:#aaa;font-size:.72rem;text-align:right;margin-top:34px}
</style>
<script>
  const fileInput = document.querySelector('#crop-file'); const wrap = document.querySelector('#canvas-wrap'); const canvas = document.querySelector('#crop-canvas'); const context = canvas.getContext('2d'); const cropButton = document.querySelector('#crop'); const wholeButton = document.querySelector('#whole'); const status = document.querySelector('#crop-status'); const result = document.querySelector('#crop-result'); let image = null; let selection = null; let dragStart = null;
  const draw = () => { if (!image) return; context.clearRect(0, 0, canvas.width, canvas.height); context.drawImage(image, 0, 0); if (selection) { context.fillStyle = 'rgba(0,0,0,.45)'; context.fillRect(0, 0, canvas.width, canvas.height); context.clearRect(selection.x, selection.y, selection.width, selection.height); context.strokeStyle = '#0f766e'; context.lineWidth = Math.max(3, canvas.width / 300); context.strokeRect(selection.x, selection.y, selection.width, selection.height); } };
  const point = (event) => { const rect = canvas.getBoundingClientRect(); return { x: Math.max(0, Math.min(canvas.width, (event.clientX - rect.left) * canvas.width / rect.width)), y: Math.max(0, Math.min(canvas.height, (event.clientY - rect.top) * canvas.height / rect.height)) }; };
  fileInput.addEventListener('change', () => { const file = fileInput.files[0]; if (!file) return; const url = URL.createObjectURL(file); const loaded = new Image(); loaded.onload = () => { image = loaded; canvas.width = image.naturalWidth; canvas.height = image.naturalHeight; wrap.hidden = false; selection = { x: 0, y: 0, width: canvas.width, height: canvas.height }; wholeButton.disabled = false; cropButton.disabled = false; status.textContent = `${canvas.width}×${canvas.height}px。残したい範囲をドラッグしてください`; draw(); URL.revokeObjectURL(url); }; loaded.onerror = () => { status.textContent = 'この画像は読み込めませんでした'; URL.revokeObjectURL(url); }; loaded.src = url; });
  canvas.addEventListener('pointerdown', (event) => { if (!image) return; canvas.setPointerCapture(event.pointerId); dragStart = point(event); selection = { x: dragStart.x, y: dragStart.y, width: 0, height: 0 }; draw(); }); canvas.addEventListener('pointermove', (event) => { if (!dragStart) return; const current = point(event); selection = { x: Math.min(dragStart.x, current.x), y: Math.min(dragStart.y, current.y), width: Math.abs(current.x - dragStart.x), height: Math.abs(current.y - dragStart.y) }; draw(); }); canvas.addEventListener('pointerup', () => { if (selection?.width < 2 || selection?.height < 2) selection = { x: 0, y: 0, width: canvas.width, height: canvas.height }; dragStart = null; draw(); });
  wholeButton.addEventListener('click', () => { selection = { x: 0, y: 0, width: canvas.width, height: canvas.height }; draw(); }); cropButton.addEventListener('click', () => { if (!image || !selection || selection.width < 2 || selection.height < 2) return; const output = document.createElement('canvas'); output.width = Math.round(selection.width); output.height = Math.round(selection.height); output.getContext('2d').drawImage(image, selection.x, selection.y, selection.width, selection.height, 0, 0, output.width, output.height); output.toBlob((blob) => { if (!blob) return; const url = URL.createObjectURL(blob); result.innerHTML = `<div class="crop-result"><img src="${url}" alt="トリミング後の画像" /><a href="${url}" download="cropped.png">トリミング画像を保存</a></div>`; status.textContent = `${output.width}×${output.height}pxに切り抜きました`; }); }); document.querySelector('#clear').addEventListener('click', () => { image = null; selection = null; dragStart = null; fileInput.value = ''; wrap.hidden = true; result.innerHTML = ''; wholeButton.disabled = true; cropButton.disabled = true; status.textContent = '画像を選択してください'; });
</script>
