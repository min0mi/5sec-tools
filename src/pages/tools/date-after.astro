---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import ToolHeader from '../../components/ToolHeader.astro'; import DateInput from '../../components/DateInput.astro'; import NumberInput from '../../components/NumberInput.astro'; import PresetChips from '../../components/PresetChips.astro'; import ResultCard from '../../components/ResultCard.astro';
---
<BaseLayout title="日付＋日数｜5秒で使えるツール.com" description="指定した日付に日数、週数、月数、年数を足した日付を計算します。"><Header /><main class="container tool-page date-pilot"><ToolHeader category="日付" title="日付＋日数" /><section class="tool-card" data-tool="date-after"><DateInput field="date" label="基準日" /><div class="choice-group"><span>方向</span><div class="segmented-control" role="group"><button type="button" data-direction="add" aria-pressed="true">後へ足す</button><button type="button" data-direction="subtract" aria-pressed="false">前へ引く</button></div></div><NumberInput field="amount" label="数値" value="30" min="0" step="1" /><div class="choice-group"><span>単位</span><div class="segmented-control" role="group"><button type="button" data-unit="day" aria-pressed="true">日</button><button type="button" data-unit="week" aria-pressed="false">週</button><button type="button" data-unit="month" aria-pressed="false">月</button><button type="button" data-unit="year" aria-pressed="false">年</button></div></div><PresetChips field="amount" values={[1,7,14,30,100]} suffix="" /><div class="tool-actions"><button type="button" data-action="today">今日に戻す</button><button type="button" data-action="reset">リセット</button></div><ResultCard copyable={true} /></section><p class="description">基準日から指定した期間を足し引きします。月・年は暦に合わせ、存在しない日付は月末に調整します。</p><p class="tool-id">T01</p></main><Footer /></BaseLayout>
<script>
  const fields = () => Object.fromEntries([...document.querySelectorAll('[data-field]')].map((el) => [el.dataset.field, el.value])); const dateInput = document.querySelector('[data-field="date"]'); const amountInput = document.querySelector('[data-field="amount"]'); const result = document.querySelector('[data-result]'); const sub = document.querySelector('[data-subresult]'); let direction = 1; let unit = 'day';
  const localToday = () => { const now = new Date(); return `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}`; }; const setToday = () => { dateInput.value = localToday(); calc(); }; const daysInMonth = (year, month) => new Date(year, month + 1, 0).getDate(); const shiftDate = (value, amount) => { const [year, month, day] = value.split('-').map(Number); const date = new Date(year, month - 1, day); const signed = amount * direction; if (unit === 'day') date.setDate(date.getDate() + signed * 1); if (unit === 'week') date.setDate(date.getDate() + signed * 7); if (unit === 'month') { const target = date.getMonth() + signed; const targetYear = date.getFullYear() + Math.floor(target / 12); const targetMonth = ((target % 12) + 12) % 12; date.setDate(Math.min(day, daysInMonth(targetYear, targetMonth))); date.setFullYear(targetYear, targetMonth, date.getDate()); } if (unit === 'year') { const targetYear = date.getFullYear() + signed; date.setDate(Math.min(day, daysInMonth(targetYear, date.getMonth()))); date.setFullYear(targetYear); } return date; };
  const calc = () => { const value = fields(); const amount = Number(value.amount); if (!value.date || !Number.isFinite(amount) || amount < 0) { result.textContent = '日付と0以上の数値を入力してください'; sub.textContent = ''; return; } const date = shiftDate(value.date, amount); const weekday = ['日','月','火','水','木','金','土'][date.getDay()]; const unitName = {day:'日',week:'週',month:'か月',year:'年'}[unit]; result.textContent = `${date.getFullYear()}年${date.getMonth()+1}月${date.getDate()}日（${weekday}）`; sub.textContent = `${value.date} から ${direction > 0 ? '+' : '-'}${amount}${unitName}`; };
  document.querySelectorAll('[data-field]').forEach((input) => { input.addEventListener('input', calc); input.addEventListener('change', calc); }); document.querySelectorAll('[data-direction]').forEach((button) => button.addEventListener('click', () => { direction = button.dataset.direction === 'add' ? 1 : -1; document.querySelectorAll('[data-direction]').forEach((item) => item.setAttribute('aria-pressed', String(item === button))); calc(); })); document.querySelectorAll('[data-unit]').forEach((button) => button.addEventListener('click', () => { unit = button.dataset.unit; document.querySelectorAll('[data-unit]').forEach((item) => item.setAttribute('aria-pressed', String(item === button))); calc(); })); document.querySelectorAll('[data-preset-field]').forEach((button) => button.addEventListener('click', () => { amountInput.value = button.dataset.presetValue; calc(); })); document.querySelector('[data-action="today"]').addEventListener('click', setToday); document.querySelector('[data-action="reset"]').addEventListener('click', () => { setToday(); amountInput.value = '30'; direction = 1; unit = 'day'; document.querySelectorAll('[data-direction]')[0].click(); document.querySelectorAll('[data-unit]')[0].click(); calc(); }); document.querySelector('[data-action="copy"]').addEventListener('click', async () => { try { await navigator.clipboard.writeText(`${result.textContent}（${sub.textContent}）`); } catch {} }); setToday();
</script>
