---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import ToolHeader from '../../components/ToolHeader.astro'; import DateInput from '../../components/DateInput.astro'; import NumberInput from '../../components/NumberInput.astro'; import PresetChips from '../../components/PresetChips.astro'; import FieldGroup from '../../components/FieldGroup.astro'; import ResultCard from '../../components/ResultCard.astro'; import RelatedTools from '../../components/RelatedTools.astro'; import { tools, getTool } from '../../lib/tools';
export function getStaticPaths() { return tools.filter((tool) => tool.status === 'published' && !['image-converter','image-crop'].includes(tool.kind)).map((tool) => ({ params: { slug: tool.slug }, props: { tool } })); }
const { tool } = Astro.props; const related = tool.relatedTools.map((slug: string) => getTool(slug)).filter(Boolean); const toolId = ({'date-after':'T01','date-before':'T02','date-difference':'T03','video-speed':'T04','discount':'T05','percentage':'T06','unit-price':'T07','hourly-monthly':'T08','character-count':'T09','random-picker':'T10'} as Record<string, string>)[tool.slug] ?? 'T00';
---
<BaseLayout title={`${tool.title}｜5秒で使えるツール.com`} description={tool.description}><Header /><main class="container tool-page"><ToolHeader category={tool.category} title={tool.title} /><section class="tool-card" data-tool={tool.kind}>
  {(tool.kind === 'date-after' || tool.kind === 'date-before') && <><DateInput field="date" label="基準日" /><NumberInput field="days" label={tool.kind === 'date-after' ? '何日後？' : '何日前？'} value="30" min="0" step="1" suffix="日" /><PresetChips field="days" values={[7,30,90,100]} suffix="日" /></>}
  {tool.kind === 'date-difference' && <><DateInput field="start" label="開始日" /><DateInput field="end" label="終了日" /><div class="tool-actions"><button type="button" data-action="today">終了日を今日にする</button></div></>}
  {tool.kind === 'video-speed' && <><NumberInput field="minutes" label="動画時間" value="90" min="0" step="0.1" suffix="分" /><NumberInput field="speed" label="再生速度" value="1.5" min="0.01" step="0.1" suffix="倍" /><PresetChips field="speed" values={[1.25,1.5,2]} suffix="倍" /></>}
  {tool.kind === 'discount' && <><NumberInput field="price" label="元の価格" value="1000" min="0" step="1" suffix="円" /><NumberInput field="rate" label="割引率" value="20" min="0" max="100" step="0.1" suffix="%" /><PresetChips field="rate" values={[5,10,20,30,50]} suffix="%" /></>}
  {tool.kind === 'percentage' && <><NumberInput field="base" label="元の数" value="1200" step="any" /><NumberInput field="rate" label="割合" value="15" min="0" step="0.1" suffix="%" /><PresetChips field="rate" values={[5,10,15,20,50]} suffix="%" /></>}
  {tool.kind === 'unit-price' && <><fieldset><legend>商品A</legend><NumberInput field="priceA" label="価格" min="0" step="any" suffix="円" /><NumberInput field="amountA" label="内容量" min="0" step="any" suffix="g" /></fieldset><fieldset><legend>商品B</legend><NumberInput field="priceB" label="価格" min="0" step="any" suffix="円" /><NumberInput field="amountB" label="内容量" min="0" step="any" suffix="g" /></fieldset></>}
  {tool.kind === 'hourly-monthly' && <><NumberInput field="hourly" label="時給" value="1200" min="0" step="1" suffix="円" /><NumberInput field="hours" label="1日の勤務時間" value="8" min="0" step="0.5" suffix="時間" /><NumberInput field="days" label="週の勤務日数" value="5" min="0" max="7" step="1" suffix="日" /><PresetChips field="days" values={[3,4,5]} suffix="日" /></>}
  {tool.kind === 'character-count' && <><FieldGroup label="文章"><textarea data-field="text" rows="8" placeholder="ここに貼り付け"></textarea></FieldGroup><div class="tool-actions"><button type="button" data-action="sample">サンプル</button><button type="button" data-action="clear">クリア</button></div></>}
  {tool.kind === 'random-picker' && <><FieldGroup label="候補（1行1つ）"><textarea data-field="options" rows="8" placeholder="りんご&#10;みかん&#10;ぶどう"></textarea></FieldGroup><div class="tool-actions"><button type="button" data-action="sample">候補を入れる</button><button type="button" data-action="clear">クリア</button><button type="button" data-action="pick">抽選</button></div></>}
  <ResultCard copyable={['date-after','date-before','date-difference','discount','percentage','unit-price','hourly-monthly'].includes(tool.kind)} />
</section><p class="description">{tool.description}</p><RelatedTools related={related} /><p class="tool-id">{toolId}</p></main><Footer /></BaseLayout>
<script define:vars={{ kind: tool.kind }}>
  const result = document.querySelector('[data-result]'); const sub = document.querySelector('[data-subresult]'); const fields = () => Object.fromEntries([...document.querySelectorAll('[data-field]')].map((el) => [el.dataset.field, el.value])); const yen = (value) => `${Math.round(value).toLocaleString('ja-JP')}円`; const invalid = (message = '入力内容を確認してください') => { if (result) result.textContent = message; if (sub) sub.textContent = ''; };
  const calc = () => { const v = fields(); try { if (kind === 'date-after' || kind === 'date-before') { if (!v.date || v.days === '' || Number(v.days) < 0) return invalid('日付と0以上の日数を入力してください'); const [y,m,d] = v.date.split('-').map(Number); const date = new Date(y,m-1,d); date.setDate(date.getDate() + (kind === 'date-after' ? Number(v.days) : -Number(v.days))); const weekday = ['日','月','火','水','木','金','土'][date.getDay()]; result.textContent = `${date.getFullYear()}年${date.getMonth()+1}月${date.getDate()}日（${weekday}）`; return; } if (kind === 'date-difference') { if (!v.start || !v.end) return invalid('開始日と終了日を入力してください'); const [sy,sm,sd] = v.start.split('-').map(Number); const [ey,em,ed] = v.end.split('-').map(Number); const days = Math.round((new Date(ey,em-1,ed).getTime()-new Date(sy,sm-1,sd).getTime())/86400000); result.textContent = `${Math.abs(days)}日`; sub.textContent = days < 0 ? '終了日が前です' : '日付の間隔'; return; } if (kind === 'video-speed') { const n=Number(v.minutes), s=Number(v.speed); if (!(n>=0) || !(s>0)) return invalid('動画時間と速度を確認してください'); const mins=n/s; result.textContent = mins >= 60 ? `${Math.floor(mins/60)}時間${Math.round(mins%60)}分` : `${Math.round(mins*10)/10}分`; sub.textContent = '実際の再生時間'; return; } if (kind === 'discount') { const p=Number(v.price), r=Number(v.rate); if (!(p>=0) || !(r>=0 && r<=100)) return invalid('価格は0以上、割引率は0〜100%で入力してください'); result.textContent=yen(p*(1-r/100)); sub.textContent=`${yen(p*r/100)}お得`; return; } if (kind === 'percentage') { const b=Number(v.base), r=Number(v.rate); if (!Number.isFinite(b)||!Number.isFinite(r)) return invalid('数値を入力してください'); result.textContent=String(Math.round(b*r/100*100)/100); sub.textContent=`${b}の${r}%`; return; } if (kind === 'unit-price') { const a=Number(v.priceA)/Number(v.amountA), b=Number(v.priceB)/Number(v.amountB); if (!(a>=0)||!(b>=0)||!(Number(v.amountA)>0)||!(Number(v.amountB)>0)) return invalid('A・Bの価格と内容量を入力してください'); const cheaper = a===b ? '同じ単価です' : `商品${a<b?'A':'B'}の方がお得`; result.textContent=cheaper; sub.textContent=`A：${a.toFixed(3)}円/g　B：${b.toFixed(3)}円/g`; return; } if (kind === 'hourly-monthly') { const h=Number(v.hourly), hours=Number(v.hours), days=Number(v.days); if (!(h>=0)||!(hours>=0)||!(days>=0&&days<=7)) return invalid('時給・時間・勤務日数を確認してください'); result.textContent=yen(h*hours*days*4.345); sub.textContent=`月収の目安 ／ 週収 ${yen(h*hours*days)} ／ 年収 ${yen(h*hours*days*52)}`; return; } if (kind === 'character-count') { const text=v.text||''; const noSpace=text.replace(/\s/g,''); const noNewline=text.replace(/[\r\n]/g,''); const lines=text ? text.split(/\r?\n/).length : 0; result.textContent=`${text.length.toLocaleString()}文字`; sub.textContent=`空白除外 ${noSpace.length.toLocaleString()}文字 ／ 改行除外 ${noNewline.length.toLocaleString()}文字 ／ ${lines}行 ／ 原稿用紙 ${Math.ceil(noNewline.length/400)}枚 ／ 読了目安 ${Math.max(1,Math.ceil(noSpace.length/500))}分`; return; } } catch { invalid(); } };
  document.querySelectorAll('[data-field]').forEach((el) => { el.addEventListener('input', calc); el.addEventListener('change', calc); }); document.querySelectorAll('[data-preset-field]').forEach((button) => button.addEventListener('click', () => { const input = document.querySelector(`[data-field="${button.dataset.presetField}"]`); if (input) { input.value = button.dataset.presetValue; input.dispatchEvent(new Event('input', { bubbles: true })); } })); document.querySelector('[data-action="today"]')?.addEventListener('click', () => { const field = document.querySelector('[data-field="end"]'); if (field) { field.value = new Date().toISOString().slice(0,10); field.dispatchEvent(new Event('input', { bubbles: true })); } }); document.querySelector('[data-action="pick"]')?.addEventListener('click', () => { const options=(fields().options||'').split(/\r?\n/).map((item) => item.trim()).filter(Boolean); result.textContent=options.length ? options[Math.floor(Math.random()*options.length)] : '候補を入力してください'; }); document.querySelector('[data-action="sample"]')?.addEventListener('click', () => { const input = document.querySelector('[data-field="text"], [data-field="options"]'); if (input) { input.value = input.dataset.field === 'options' ? 'りんご\nみかん\nぶどう' : 'これは文字数を数えるサンプル文章です。'; input.dispatchEvent(new Event('input', { bubbles: true })); } }); document.querySelector('[data-action="clear"]')?.addEventListener('click', () => { document.querySelectorAll('[data-field]').forEach((input) => { if (input.type !== 'date') input.value = ''; input.dispatchEvent(new Event('input', { bubbles: true })); }); }); document.querySelector('[data-action="copy"]')?.addEventListener('click', async () => { const text = [result?.textContent, sub?.textContent].filter(Boolean).join(' / '); if (text) { try { await navigator.clipboard.writeText(text); } catch {} } }); document.querySelectorAll('input[type="date"]').forEach((input) => { if (!input.value) input.value = new Date().toISOString().slice(0,10); }); calc();
</script>
