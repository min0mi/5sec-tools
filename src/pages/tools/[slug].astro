---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import { tools, getTool } from '../../lib/tools';
export function getStaticPaths() { return tools.filter(t => t.status === 'published').map(tool => ({ params: { slug: tool.slug }, props: { tool } })); }
const { tool } = Astro.props; const related = tool.relatedTools.map((slug: string) => getTool(slug)).filter(Boolean); const toolId = ({'date-after':'T01','date-before':'T02','date-difference':'T03','video-speed':'T04','discount':'T05','percentage':'T06','unit-price':'T07','hourly-monthly':'T08','character-count':'T09','random-picker':'T10'} as Record<string, string>)[tool.slug] ?? 'T00'; const currentYear = new Date().getFullYear(); const dateYears = Array.from({ length: 201 }, (_, index) => currentYear - 100 + index); const dateMonths = Array.from({ length: 12 }, (_, index) => index + 1); const dateDays = Array.from({ length: 31 }, (_, index) => index + 1); const options = (max: number, step = 1) => Array.from({ length: Math.floor(max / step) + 1 }, (_, index) => Number((index * step).toFixed(2))); const daysOptions = options(365); const minuteOptions = options(600, 5); const speedOptions = options(4, 0.25).filter((value) => value > 0); const moneyOptions = options(100000, 100); const hourOptions = options(24, 0.5); const workDaysOptions = options(7, 1);
---
<BaseLayout title={`${tool.title}｜5秒で使えるツール.com`} description={tool.description}><Header /><main class="container tool-page"><p class="eyebrow">{tool.category}</p><div class="title-row"><h1>{tool.title}</h1></div><section class="tool-card" data-tool={tool.kind}>
  {tool.kind === 'date-after' || tool.kind === 'date-before' ? <><label class="date-field"><span>基準日</span><span class="date-selects" data-date-group="date"><select data-date-part="year" aria-label="基準日の年">{dateYears.map((year) => <option value={year}>{year}年</option>)}</select><select data-date-part="month" aria-label="基準日の月">{dateMonths.map((month) => <option value={month}>{month}月</option>)}</select><select data-date-part="day" aria-label="基準日の日">{dateDays.map((day) => <option value={day}>{day}日</option>)}</select><input data-field="date" type="hidden" /></span></label><label>日数<select data-field="days">{daysOptions.map((value) => <option value={value}>{value}日</option>)}</select></label><div class="presets"><button type="button" data-preset-field="days" data-preset-value="7">7日</button><button type="button" data-preset-field="days" data-preset-value="30">30日</button><button type="button" data-preset-field="days" data-preset-value="90">90日</button><button type="button" data-preset-field="days" data-preset-value="100">100日</button></div></> : null}
  {tool.kind === 'date-difference' ? <><label class="date-field"><span>開始日</span><span class="date-selects" data-date-group="start"><select data-date-part="year" aria-label="開始日の年">{dateYears.map((year) => <option value={year}>{year}年</option>)}</select><select data-date-part="month" aria-label="開始日の月">{dateMonths.map((month) => <option value={month}>{month}月</option>)}</select><select data-date-part="day" aria-label="開始日の日">{dateDays.map((day) => <option value={day}>{day}日</option>)}</select><input data-field="start" type="hidden" /></span></label><label class="date-field"><span>終了日</span><span class="date-selects" data-date-group="end"><select data-date-part="year" aria-label="終了日の年">{dateYears.map((year) => <option value={year}>{year}年</option>)}</select><select data-date-part="month" aria-label="終了日の月">{dateMonths.map((month) => <option value={month}>{month}月</option>)}</select><select data-date-part="day" aria-label="終了日の日">{dateDays.map((day) => <option value={day}>{day}日</option>)}</select><input data-field="end" type="hidden" /></span></label><div class="tool-actions"><button type="button" data-action="today">今日を終了日にする</button></div></> : null}
  {tool.kind === 'video-speed' ? <><label>動画時間（分）<input data-field="minutes" type="number" min="0" value="90" inputmode="decimal" /></label><label>再生速度（倍）<input data-field="speed" type="number" min="0.01" step="0.1" value="1.5" inputmode="decimal" /></label><div class="presets"><span>速度：</span><button type="button" data-preset-field="speed" data-preset-value="1.25">1.25倍</button><button type="button" data-preset-field="speed" data-preset-value="1.5">1.5倍</button><button type="button" data-preset-field="speed" data-preset-value="2">2倍</button></div></> : null}
  {tool.kind === 'discount' ? <><label>元の価格（円）<input data-field="price" type="number" min="0" value="1000" inputmode="decimal" /></label><label>割引率（%）<select data-field="rate">{options(100).map((value) => <option value={value} selected={value === 20}>{value}%</option>)}</select></label><div class="presets"><span>よく使う率：</span><button type="button" data-preset-field="rate" data-preset-value="5">5%</button><button type="button" data-preset-field="rate" data-preset-value="10">10%</button><button type="button" data-preset-field="rate" data-preset-value="20">20%</button><button type="button" data-preset-field="rate" data-preset-value="30">30%</button><button type="button" data-preset-field="rate" data-preset-value="50">50%</button></div></> : null}
  {tool.kind === 'percentage' ? <><label>元の数<input data-field="base" type="number" value="1200" inputmode="decimal" /></label><label>割合（%）<select data-field="rate">{options(100).map((value) => <option value={value} selected={value === 15}>{value}%</option>)}</select></label><div class="presets"><span>よく使う率：</span><button type="button" data-preset-field="rate" data-preset-value="5">5%</button><button type="button" data-preset-field="rate" data-preset-value="10">10%</button><button type="button" data-preset-field="rate" data-preset-value="15">15%</button><button type="button" data-preset-field="rate" data-preset-value="20">20%</button><button type="button" data-preset-field="rate" data-preset-value="50">50%</button></div></> : null}
  {tool.kind === 'unit-price' ? <><fieldset><legend>商品A</legend><label>価格（円）<input data-field="priceA" type="number" min="0" inputmode="decimal" /></label><label>内容量<input data-field="amountA" type="number" min="0" inputmode="decimal" /></label></fieldset><fieldset><legend>商品B</legend><label>価格（円）<input data-field="priceB" type="number" min="0" inputmode="decimal" /></label><label>内容量<input data-field="amountB" type="number" min="0" inputmode="decimal" /></label></fieldset></> : null}
  {tool.kind === 'hourly-monthly' ? <><label>時給（円）<input data-field="hourly" type="number" min="0" value="1200" inputmode="decimal" /></label><label>1日の勤務時間<input data-field="hours" type="number" min="0" step="0.5" value="8" inputmode="decimal" /></label><label>週の勤務日数<input data-field="days" type="number" min="0" max="7" value="5" inputmode="numeric" /></label><div class="presets"><span>勤務日数：</span><button type="button" data-preset-field="days" data-preset-value="3">週3日</button><button type="button" data-preset-field="days" data-preset-value="4">週4日</button><button type="button" data-preset-field="days" data-preset-value="5">週5日</button></div></> : null}
  {tool.kind === 'character-count' ? <><label>文章<textarea data-field="text" rows="8" placeholder="ここに貼り付け"></textarea></label><div class="tool-actions"><button type="button" data-action="sample">サンプル</button><button type="button" data-action="clear">クリア</button><button type="button" data-action="copy">結果をコピー</button></div></> : null}
  {tool.kind === 'random-picker' ? <><label>候補（1行1つ）<textarea data-field="options" rows="8" placeholder="りんご&#10;みかん&#10;ぶどう"></textarea></label><div class="tool-actions"><button type="button" data-action="sample">候補を入れる</button><button type="button" data-action="clear">クリア</button><button type="button" data-action="pick">抽選</button><button type="button" data-action="copy">結果をコピー</button></div></> : null}
  <div class="result" aria-live="polite"><span class="result-label">結果</span><strong data-result>入力すると表示</strong><span data-subresult></span></div>
</section><p class="description">{tool.description}</p><section><h2>関連ツール</h2><div class="related">{related.map((item) => item && <a href={`/tools/${item.slug}/`}>{item.shortTitle}</a>)}</div></section><p class="tool-id">{toolId}</p></main><Footer /></BaseLayout>
<script define:vars={{ kind: tool.kind }}>
  const result = document.querySelector('[data-result]'); const sub = document.querySelector('[data-subresult]'); const fields = () => Object.fromEntries([...document.querySelectorAll('[data-field]')].map((el) => [el.dataset.field, el.value]));
  const number = (v) => Number(v); const yen = (v) => `${Math.round(v).toLocaleString('ja-JP')}円`; const invalid = () => { if (result) result.textContent = '入力内容を確認してください'; if (sub) sub.textContent = ''; };
  const calc = () => { const v = fields(); try { if (kind === 'date-after' || kind === 'date-before') { if (!v.date || v.days === '' || number(v.days) < 0) return invalid(); const [y,m,d] = v.date.split('-').map(Number); const date = new Date(y,m-1,d); date.setDate(date.getDate() + (kind === 'date-after' ? number(v.days) : -number(v.days))); if (result) result.textContent = `${date.getFullYear()}年${date.getMonth()+1}月${date.getDate()}日`; return; } if (kind === 'date-difference') { if (!v.start || !v.end) return invalid(); const [sy,sm,sd] = v.start.split('-').map(Number); const [ey,em,ed] = v.end.split('-').map(Number); const days = Math.round((new Date(ey,em-1,ed).getTime()-new Date(sy,sm-1,sd).getTime())/86400000); if(result) result.textContent = `${Math.abs(days)}日`; if(sub) sub.textContent = days < 0 ? '終了日が前です' : ''; return; } if (kind === 'video-speed') { const n=number(v.minutes), s=number(v.speed); if(!(n>=0) || !(s>0)) return invalid(); const mins=n/s; if(result) result.textContent = mins >= 60 ? `${Math.floor(mins/60)}時間${Math.round(mins%60)}分` : `${Math.round(mins*10)/10}分`; return; } if (kind === 'discount') { const p=number(v.price), r=number(v.rate); if(!(p>=0) || !(r>=0 && r<=100)) return invalid(); if(result) result.textContent=yen(p*(1-r/100)); if(sub) sub.textContent=`${yen(p*r/100)}お得`; return; } if (kind === 'percentage') { const b=number(v.base), r=number(v.rate); if(!Number.isFinite(b)||!Number.isFinite(r)) return invalid(); if(result) result.textContent=String(Math.round(b*r/100*100)/100); return; } if (kind === 'unit-price') { const a=number(v.priceA)/number(v.amountA), b=number(v.priceB)/number(v.amountB); if(!(a>=0)||!(b>=0)||!(number(v.amountA)>0)||!(number(v.amountB)>0)) return invalid(); if(result) result.textContent=`A：${a.toFixed(2)}円 / B：${b.toFixed(2)}円`; if(sub) sub.textContent=a===b?'同じ単価です':`${a<b?'A':'B'}の方が単価が安い`; return; } if (kind === 'hourly-monthly') { const h=number(v.hourly), hours=number(v.hours), days=number(v.days); if(!(h>=0)||!(hours>=0)||!(days>=0&&days<=7)) return invalid(); if(result) result.textContent=yen(h*hours*days*4.345); if(sub) sub.textContent=`週収 ${yen(h*hours*days)} ／ 年収 ${yen(h*hours*days*52)}`; return; } if (kind === 'character-count') { const text=v.text||''; if(result) result.textContent=`${text.length.toLocaleString()}文字`; if(sub) sub.textContent=`空白除外 ${text.replace(/\s/g,'').length.toLocaleString()}文字 ／ ${text ? text.split(/\r?\n/).length : 0}行`; return; } } catch { invalid(); } };
  document.querySelectorAll('[data-field]').forEach((el) => { el.addEventListener('input', calc); el.addEventListener('change', calc); }); document.querySelector('[data-action="pick"]')?.addEventListener('click', () => { const options=(fields().options||'').split(/\r?\n/).filter(Boolean); if(result) result.textContent=options.length ? options[Math.floor(Math.random()*options.length)] : '候補を入力してください'; }); document.querySelectorAll('.date-field').forEach((field) => field.addEventListener('click', (event) => { if (event.target !== field.querySelector('input')) { const input = field.querySelector('input'); input?.focus(); input?.showPicker?.(); } })); calc();
</script>
<script>
  const today = new Date();
  document.querySelectorAll('[data-date-group]').forEach((group) => { const hidden = group.querySelector('input[data-field]'); const year = group.querySelector('[data-date-part="year"]'); const month = group.querySelector('[data-date-part="month"]'); const day = group.querySelector('[data-date-part="day"]'); year.value = String(today.getFullYear()); month.value = String(today.getMonth() + 1); day.value = String(today.getDate()); hidden.value = `${year.value}-${String(month.value).padStart(2, '0')}-${String(day.value).padStart(2, '0')}`; [year, month, day].forEach((select) => select.addEventListener('change', () => { hidden.value = `${year.value}-${String(month.value).padStart(2, '0')}-${String(day.value).padStart(2, '0')}`; hidden.dispatchEvent(new Event('input', { bubbles: true })); })); hidden.dispatchEvent(new Event('input', { bubbles: true })); });
</script>
<script>
  const card = document.querySelector('.tool-card');
  const fire = (input) => input?.dispatchEvent(new Event('input', { bubbles: true }));
  const setToday = (field) => { const group = field?.closest('[data-date-group]'); const now = new Date(); if (group) { group.querySelector('[data-date-part="year"]').value = String(now.getFullYear()); group.querySelector('[data-date-part="month"]').value = String(now.getMonth() + 1); group.querySelector('[data-date-part="day"]').value = String(now.getDate()); fire(field); } };
  document.querySelectorAll('[data-preset-field]').forEach((button) => button.addEventListener('click', () => { const input = document.querySelector(`[data-field="${button.dataset.presetField}"]`); if (input) { input.value = button.dataset.presetValue ?? ''; fire(input); } }));
  document.querySelector('[data-action="today"]')?.addEventListener('click', () => setToday(document.querySelector('[data-field="end"]')));
  document.querySelector('[data-action="sample"]')?.addEventListener('click', () => { const input = document.querySelector('[data-field="text"], [data-field="options"]'); if (!input) return; input.value = input.dataset.field === 'options' ? 'りんご\nみかん\nぶどう' : 'これは文字数を数えるためのサンプル文章です。'; fire(input); });
  document.querySelector('[data-action="clear"]')?.addEventListener('click', () => { document.querySelectorAll('[data-field]').forEach((input) => { if (input.type !== 'date') input.value = ''; fire(input); }); });
  document.querySelector('[data-action="copy"]')?.addEventListener('click', async () => { const text = [document.querySelector('[data-result]')?.textContent, document.querySelector('[data-subresult]')?.textContent].filter(Boolean).join(' / '); if (text) { try { await navigator.clipboard.writeText(text); } catch {} } });
  if (card?.dataset.tool === 'character-count') { const text = document.querySelector('[data-field="text"]'); const sub = document.querySelector('[data-subresult]'); text?.addEventListener('input', () => { const value = text.value || ''; const noSpace = value.replace(/\s/g, ''); const noNewline = value.replace(/[\r\n]/g, ''); const lines = value ? value.split(/\r?\n/).length : 0; const pages = Math.ceil(noNewline.length / 400); const minutes = Math.max(1, Math.ceil(noSpace.length / 500)); if (sub) sub.textContent = `空白除外 ${noSpace.length.toLocaleString()}文字 ／ 改行除外 ${noNewline.length.toLocaleString()}文字 ／ ${lines}行 ／ ${pages}枚 ／ 読了目安 ${minutes}分`; }); }
</script>
