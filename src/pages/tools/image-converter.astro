---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro';
---
<BaseLayout title="画像ファイル形式変換｜5秒で使えるツール.com" description="画像をPNG・JPG・WebPなどへ変換。サイズ変更と品質調整にも対応します。"><Header /><main class="container image-page"><p class="eyebrow">画像</p><h1>画像ファイル形式変換</h1><p class="lead">画像を選ぶだけで、形式・サイズ・品質をまとめて変更できます。</p>
  <section class="image-tool" aria-label="画像変換設定">
    <label class="drop-zone" id="drop-zone"><input id="file-input" type="file" accept="image/*,.svg" multiple /><strong>画像を選択</strong><span>ここにドラッグ＆ドロップ（複数可）</span></label>
    <div id="file-list" class="file-list" aria-live="polite"></div>
    <div class="image-settings">
      <label>変換後の形式<select id="format"><option value="image/webp">WebP（軽量）</option><option value="image/jpeg">JPG（写真向け）</option><option value="image/png">PNG（透明対応）</option></select></label>
      <label>品質 <output id="quality-value" for="quality">80</output>%<input id="quality" type="range" min="10" max="100" value="80" /></label>
      <label>最大幅（px）<input id="max-width" type="number" min="1" placeholder="元サイズのまま" inputmode="numeric" /></label>
      <label>最大高さ（px）<input id="max-height" type="number" min="1" placeholder="元サイズのまま" inputmode="numeric" /></label>
      <label>背景色（JPG変換時）<input id="background" type="color" value="#ffffff" /></label>
    </div>
    <div class="image-actions"><button id="convert" type="button" disabled>まとめて変換</button><button id="download-all" type="button" disabled>すべて保存</button><button id="clear" type="button">クリア</button></div>
    <p id="status" class="status" role="status">画像を選択してください</p><div id="results" class="image-results"></div>
  </section>
  <p class="notice">画像はサーバーへ送信せず、このブラウザ内で処理します。アニメーションGIFは先頭フレームのみ、SVGは画像として読み込める範囲でラスター化します。変換後のファイルはページを閉じると消えます。</p>
  <p class="tool-id">T11</p>
</main><Footer /></BaseLayout>
<style>
  .image-page h1{margin-bottom:10px}.lead{color:#555;margin:0 0 24px}.image-tool{max-width:680px}.drop-zone{min-height:150px;border:2px dashed #a8c9c1;border-radius:12px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;background:#f7fcfa;text-align:center;padding:20px;cursor:pointer}.drop-zone:hover,.drop-zone.is-dragging{background:#eaf7f2;border-color:var(--accent)}.drop-zone input{position:absolute;width:1px;height:1px;opacity:0}.drop-zone span{font-size:.85rem;color:#666}.file-list{margin:16px 0}.file-item{display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-bottom:1px solid #eee;font-size:.9rem}.file-item small{color:#777}.image-settings{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin:24px 0}.image-settings label{font-weight:600}.image-settings select,.image-settings input{display:block;width:100%;margin-top:5px;border:1px solid #bbb;border-radius:6px;padding:10px;background:#fff;font:inherit}.image-settings input[type=range]{padding:0}.image-settings input[type=color]{height:44px;padding:3px}.image-actions{display:flex;gap:8px;flex-wrap:wrap}.image-actions button{border-radius:7px}.image-actions button:first-child{background:var(--accent);color:#fff;border-color:var(--accent)}.status{min-height:1.6em;color:#555}.image-results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.result-item{padding:12px 0;border-top:1px solid #eee}.result-item img{width:100%;height:180px;object-fit:contain;background:repeating-conic-gradient(#f2f2f2 0 25%,#fff 0 50%) 50%/16px 16px}.result-item p{font-size:.85rem;margin:6px 0}.result-item a{display:inline-block;color:var(--accent);font-weight:600}.notice{max-width:680px;color:#666;font-size:.82rem;margin-top:24px}.tool-id{color:#aaa;font-size:.72rem;text-align:right;margin-top:34px}@media(max-width:560px){.image-settings,.image-results{grid-template-columns:1fr}}
</style>
<script>
  const files = []; const outputs = []; const input = document.querySelector('#file-input'); const drop = document.querySelector('#drop-zone'); const list = document.querySelector('#file-list'); const results = document.querySelector('#results'); const convert = document.querySelector('#convert'); const downloadAll = document.querySelector('#download-all'); const status = document.querySelector('#status'); const format = document.querySelector('#format'); const quality = document.querySelector('#quality'); const qualityValue = document.querySelector('#quality-value');
  const setStatus = (message) => { status.textContent = message; }; const extension = (mime) => mime.split('/')[1] === 'jpeg' ? 'jpg' : mime.split('/')[1]; const formatName = (mime) => ({'image/webp':'WebP','image/jpeg':'JPG','image/png':'PNG'})[mime]; const bytes = (size) => size < 1024 ? `${size} B` : `${(size / 1024).toFixed(1)} KB`;
  const renderFiles = () => { list.innerHTML = files.map((file) => `<div class="file-item"><span>${file.name}</span><small>${bytes(file.size)}</small></div>`).join(''); convert.disabled = files.length === 0; setStatus(files.length ? `${files.length}枚選択中` : '画像を選択してください'); };
  const addFiles = (selected) => { [...selected].filter((file) => file.type.startsWith('image/') || file.name.toLowerCase().endsWith('.svg')).forEach((file) => files.push(file)); renderFiles(); };
  input.addEventListener('change', () => addFiles(input.files)); drop.addEventListener('dragover', (event) => { event.preventDefault(); drop.classList.add('is-dragging'); }); drop.addEventListener('dragleave', () => drop.classList.remove('is-dragging')); drop.addEventListener('drop', (event) => { event.preventDefault(); drop.classList.remove('is-dragging'); addFiles(event.dataTransfer.files); }); quality.addEventListener('input', () => qualityValue.textContent = quality.value);
  const loadImage = (file) => new Promise((resolve, reject) => { const image = new Image(); const url = URL.createObjectURL(file); image.onload = () => { URL.revokeObjectURL(url); resolve(image); }; image.onerror = () => { URL.revokeObjectURL(url); reject(new Error('読み込めない画像')); }; image.src = url; });
  const convertOne = async (file) => { const image = await loadImage(file); const maxWidth = Number(document.querySelector('#max-width').value) || image.naturalWidth; const maxHeight = Number(document.querySelector('#max-height').value) || image.naturalHeight; const scale = Math.min(1, maxWidth / image.naturalWidth, maxHeight / image.naturalHeight); const canvas = document.createElement('canvas'); canvas.width = Math.max(1, Math.round(image.naturalWidth * scale)); canvas.height = Math.max(1, Math.round(image.naturalHeight * scale)); const context = canvas.getContext('2d'); if (format.value === 'image/jpeg') { context.fillStyle = document.querySelector('#background').value; context.fillRect(0, 0, canvas.width, canvas.height); } context.drawImage(image, 0, 0, canvas.width, canvas.height); const blob = await new Promise((resolve) => canvas.toBlob(resolve, format.value, Number(quality.value) / 100)); if (!blob) throw new Error('変換できませんでした'); return { blob, width: canvas.width, height: canvas.height, name: `${file.name.replace(/\.[^.]+$/, '')}.${extension(format.value)}` }; };
  const renderResults = () => { results.innerHTML = outputs.map((item, index) => `<article class="result-item"><img src="${item.url}" alt="${item.name}のプレビュー" /><p>${item.name}<br /><small>${item.width}×${item.height}px ／ ${bytes(item.blob.size)}</small></p><a href="${item.url}" download="${item.name}">この画像を保存</a></article>`).join(''); downloadAll.disabled = outputs.length === 0; };
  convert.addEventListener('click', async () => { convert.disabled = true; outputs.splice(0).forEach((item) => URL.revokeObjectURL(item.url)); results.innerHTML = ''; setStatus('変換中…'); for (const file of files) { try { const item = await convertOne(file); item.url = URL.createObjectURL(item.blob); outputs.push(item); renderResults(); } catch { setStatus(`${file.name}を変換できませんでした`); } } setStatus(`${outputs.length}枚を${formatName(format.value)}に変換しました`); convert.disabled = false; });
  downloadAll.addEventListener('click', () => outputs.forEach((item, index) => setTimeout(() => { const link = document.createElement('a'); link.href = item.url; link.download = item.name; link.click(); }, index * 150)));
  document.querySelector('#clear').addEventListener('click', () => { files.splice(0); outputs.splice(0).forEach((item) => URL.revokeObjectURL(item.url)); input.value = ''; list.innerHTML = ''; results.innerHTML = ''; downloadAll.disabled = true; convert.disabled = true; setStatus('画像を選択してください'); });
</script>
